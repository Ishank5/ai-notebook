platform :ios, '15.0'
use_frameworks!

target 'iosApp' do
  pod 'shared', :path => '../shared'
  # Auth is the only Firebase pod. The notetaker's data goes through the
  # ntApi Cloud Function (see iosApp/repository/ApiClient.swift).
  pod 'FirebaseAuth'
end

# Xcode 27 refuses to build pod targets set below iOS 15, and some
# of FirebaseAuth's dependencies still declare 9 to 12. They are raised to this
# Podfile's own platform; nothing at or above it is touched.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end
  end
end
