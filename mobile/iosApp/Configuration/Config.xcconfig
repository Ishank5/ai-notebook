TEAM_ID=

PRODUCT_NAME=AINotebook
PRODUCT_BUNDLE_IDENTIFIER=com.humblesolutions.ainotetaker$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0.0

// The AI Notebook API (Info.plist ApiBaseUrl), the ntApi Cloud Function.
// Paths such as /api/me are appended to it. `$()` keeps the two slashes from
// starting a comment.
API_BASE_URL = https:/$()/us-central1-team-akshay-sharma.cloudfunctions.net/ntApi

// The Kotlin/Native SQLite driver behind the recordings queue (SQLDelight's
// native driver) binds the system sqlite3 through cinterop, which does not
// carry a link instruction, so the app links it here.
OTHER_LDFLAGS = $(inherited) -lsqlite3
