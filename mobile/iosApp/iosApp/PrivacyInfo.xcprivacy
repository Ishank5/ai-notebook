<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  THE APP'S OWN PRIVACY MANIFEST. Required since 1 May 2024, and its absence
	  is not a warning: the upload is rejected outright with ITMS-91053 naming
	  every Required Reason API the binary called without declaring why.

	  THE PODS HAVE THEIRS; THE APP TARGET HAD NONE. Nineteen manifests ship
	  inside iosApp/Pods (Firebase and friends) and they cover only their own
	  code. This file covers ours.

	  IT IS PICKED UP BY BEING HERE. The iosApp folder is a
	  PBXFileSystemSynchronizedRootGroup (objectVersion 77), so every file in it
	  is a member of the target automatically — no pbxproj entry to forget.

	  KEEP IN STEP WITH APP STORE CONNECT. The data types below and the App
	  Privacy answers on the listing are two copies of one fact, and App Review
	  reads both.
	-->

	<key>NSPrivacyTracking</key>
	<false/>

	<!-- No ad network, no attribution SDK, nothing to reach. -->
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!--
			  The only Required Reason API in our code: UserDefaults, in
			  KeyStore, DraftStore, AppearanceStore and LanguageStore.
			  CA92.1 — accessed only to read and write this app's own values.
			-->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<!--
			  The meeting recorder checks the free space before it starts, so a
			  recording is refused up front rather than cut off by a full disk
			  halfway through (IOSRecordingFiles.freeBytes).
			  E174.1 — checking there is room to write files.
			-->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!--
		  EVERY ENTRY IS LINKED AND NONE IS TRACKING. This is a team roster:
		  there is nothing here that is not deliberately tied to a named person,
		  and nothing that goes to a third party for advertising.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key><true/>
			<key>NSPrivacyCollectedDataTypeTracking</key><false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key><true/>
			<key>NSPrivacyCollectedDataTypeTracking</key><false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
		</dict>
		<dict>
			<!-- The username minted for a member, and the Firebase uid behind it. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key><true/>
			<key>NSPrivacyCollectedDataTypeTracking</key><false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
		</dict>
		<dict>
			<!--
			  MEETING RECORDINGS. The audio is uploaded to the campaign's own
			  Firebase project and summarised for the team's leaders, so it is
			  collected, linked to the person who recorded it, and used for
			  nothing but that.
			-->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeAudioData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key><true/>
			<key>NSPrivacyCollectedDataTypeTracking</key><false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
		</dict>
		<dict>
			<!--
			  What a worker types about a meeting — its title, where it was, who
			  was there — and the summary made from its recording.
			-->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key><true/>
			<key>NSPrivacyCollectedDataTypeTracking</key><false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
		</dict>
	</array>
</dict>
</plist>
